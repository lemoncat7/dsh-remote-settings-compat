{
  "name": "@lemoncat7/dsh-remote-settings-compat",
  "version": "0.6.4",
  "description": "Unified trusted settings and password access gateway for DeepSeek Harness",
  "homepage": "https://github.com/lemoncat7/dsh-remote-settings-compat#readme",
  "bugs": {
    "url": "https://github.com/lemoncat7/dsh-remote-settings-compat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemoncat7/dsh-remote-settings-compat.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "remote-settings",
    "trusted-origin",
    "authentication",
    "password-gate",
    "reverse-proxy"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./access": {
      "types": "./lib/access/index.d.ts",
      "default": "./lib/access/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "docs/releases/0.6.3.md",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/releases/0.6.1.md",
    "docs/dsh-020-compatibility.md",
    "docs/dsh-021-compatibility.md",
    "docs/releases/0.6.4.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "prepare": "npm run clean && npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "http-proxy": "^1.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/http-proxy": "^1.17.16",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-app-boot": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
